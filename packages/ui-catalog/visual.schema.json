{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearnQuest visual spec",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "blocks": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "diagram"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,24}$"
              },
              "props": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "flow",
                      "tree",
                      "cycle",
                      "timeline",
                      "graph",
                      "labelled"
                    ]
                  },
                  "shape": {
                    "type": "string",
                    "enum": [
                      "rect",
                      "round",
                      "diamond",
                      "circle"
                    ]
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "nodes": {
                    "minItems": 1,
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9_]{1,24}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "edges": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[a-z0-9_]{1,24}$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[a-z0-9_]{1,24}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "kind",
                  "alt",
                  "nodes",
                  "edges"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "id",
              "props"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "image"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,24}$"
              },
              "props": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "asset"
                  },
                  "assetId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "source",
                  "assetId",
                  "alt"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "id",
              "props"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,24}$"
              },
              "props": {
                "type": "object",
                "properties": {
                  "md": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "md"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "id",
              "props"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "v",
    "blocks"
  ],
  "additionalProperties": false
}
