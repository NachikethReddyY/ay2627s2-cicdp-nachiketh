{
  "name": "learnquest",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/*.test.ts",
    "lint:types": "oxlint --type-aware -c .oxlintrc.json --max-warnings 68 apps packages e2e scripts && tsc -p scripts/tsconfig.json",
    "lint:comments": "node scripts/check-comments.ts",
    "agent:verify": "scripts/agent-verify.sh",
    "agent:merge": "echo \"agent:merge is retired. Run: git fetch origin +refs/heads/main:refs/remotes/origin/main && git cat-file -e refs/remotes/origin/main:scripts/merge-gate-bootstrap.sh && git show refs/remotes/origin/main:scripts/merge-gate-bootstrap.sh | bash -s -- <pr>\" && exit 2",
    "revert-rate": "node scripts/revert-rate.ts",
    "validator": "node tools/validator/src/cli.ts",
    "validator:up": "node tools/validator/src/cli.ts up",
    "validator:down": "node tools/validator/src/cli.ts down",
    "validator:smoke": "node tools/validator/src/cli.ts smoke",
    "review": "node scripts/agent-review.ts",
    "index": "node tools/repo-index/src/cli.ts index"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@babel/types": "^8.1.3",
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  }
}
