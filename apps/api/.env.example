DATABASE_URL=postgres://learnquest:learnquest@localhost:5432/learnquest
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:5173
# BETTER_AUTH_URL defaults to PUBLIC_ORIGIN
PORT=3000
NODE_ENV=development
# Set to your reverse proxy address (e.g. 10.0.0.5) so per-IP rate limits see real clients. Unset = trust no forwarded IP.
# TRUSTED_PROXY=
# Dev-only prompt playground (/api/dev/visual). ENGINE_TOKEN must equal the engine's ENGINE_TOKEN (32+ chars).
# ENGINE_URL=http://localhost:8000
# ENGINE_TOKEN=
# Estimated cost of one generated image, reserved against the AI budget (default 0.04).
# IMAGE_ESTIMATE_USD=0.04
# Estimated cost of one paid text call, reserved against AI_DAILY_BUDGET_USD / AI_MONTHLY_BUDGET_USD (default 0.01).
# A budget of 0 means no limit.
# AI_CALL_ESTIMATE_USD=0.01
# Daily and monthly AI spend caps in USD. In production with AI on, the API refuses to start when both are 0
# unless AI_BUDGET_UNLIMITED=true is set on purpose.
# AI_DAILY_BUDGET_USD=5
# AI_MONTHLY_BUDGET_USD=100
# AI_BUDGET_UNLIMITED=false
# Publishing a path to the community list needs moderation: without this key, publish is refused.
# MODERATION_API_KEY=
# Code sandbox (off by default). Shell containers join SANDBOX_NETWORK; see services/sandbox/README.md for the host egress rules.
# SANDBOX_ENABLED=false
# SANDBOX_IMAGE=lq-sandbox:dev
# SANDBOX_NETWORK=lq-sbx
# SANDBOX_RUNTIME=runsc
# SANDBOX_MAX_TABS=4
# SANDBOX_MAX_SHELLS=50
# SANDBOX_MAX_RUNS=20
# Repos (comma-separated owner/name) that authors may import commits from. Empty: every import is rejected.
# IMPORT_REPO_ALLOWLIST=owner/name,owner/other
