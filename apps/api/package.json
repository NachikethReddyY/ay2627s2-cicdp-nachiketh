{
  "name": "@learnquest/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/server.ts",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=87 --test-coverage-branches=83 --test-coverage-exclude='**/*.test.ts' --test-concurrency=1 'test/**/*.test.ts'",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/db/seed.ts",
    "media:narration": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/media/import-narration.ts"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "0.17.4",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@daytonaio/sdk": "^0.231.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/websocket": "^11.3.7",
    "@learnquest/player-core": "workspace:*",
    "@learnquest/ui-catalog": "workspace:*",
    "@trpc/server": "^11.26.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@typescript/typescript6": "6.0.2",
    "better-auth": "^1.7.19",
    "drizzle-orm": "^0.45.4",
    "eslint": "10.14.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "globals": "17.14.0",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
