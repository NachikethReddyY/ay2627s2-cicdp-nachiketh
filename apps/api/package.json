{
  "name": "@learnquest/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/server.ts",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/db/seed.ts",
    "media:narration": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../services/engine/.env --env-file-if-exists=.env src/media/import-narration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/websocket": "^11.3.6",
    "@learnquest/player-core": "workspace:*",
    "@learnquest/ui-catalog": "workspace:*",
    "@trpc/server": "^11.22.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
