{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["LEARNSLOP_USE_CACHED_RELEASES"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "env": ["TEST_DATABASE_URL", "BETTER_AUTH_SECRET", "ISOLATE_API_TEST_DATABASES"],
      "passThroughEnv": ["API_COVERAGE_FILE"]
    }
  }
}
